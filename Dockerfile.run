# Shiori 実行用軽量イメージ。
#
# 開発用コンテナの Dockerfile とは別物。こちらはバイナリ実行専用。
# 既存の Dockerfile には触らないこと。
#
# ビルド:
#   docker build -f Dockerfile.run -t shiori .
#
# modernc.org/sqlite（ピュアGo）のため CGO 不要。
# 静的バイナリ化して scratch で動かす。

FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/shiori ./cmd/shiori \
 && mkdir -p /out/data && chmod 755 /out/data

FROM scratch
COPY --from=build /out/shiori /shiori
# /app/data をあらかじめイメージ内に用意し、UID 65532 所有にしておく。
# 新規の名前付きボリュームは初回マウント時にイメージ側の内容・所有権を引き継ぐため、
# これがないとボリュームが root 所有で作られ、非root実行時に
# `pragma "PRAGMA journal_mode=WAL;": unable to open database file (14)` になる。
COPY --from=build --chown=65532:65532 /out/data /app/data
WORKDIR /app
VOLUME /app/data
EXPOSE 8080
# 非root実行。bind mount で権限問題が出たら --user $(id -u):$(id -g) を付ける。
USER 65532:65532
ENTRYPOINT ["/shiori"]
